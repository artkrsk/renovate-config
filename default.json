{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    ":disableDependencyDashboard"
  ],
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "1 day",
  "automerge": true,
  "packageRules": [
    {
      "matchDepTypes": ["dependencies", "require"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Reusable workflows are consumed from @main on purpose; a digest pin freezes a repo on an old revision and turns every workflow change into a per-repo PR",
      "matchDepNames": ["artkrsk/wordpress-plugin-workflows"],
      "pinDigests": false
    }
  ]
}
